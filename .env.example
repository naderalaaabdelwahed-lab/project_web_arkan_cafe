NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY

# Local face recognition service (run face-service on the same computer as Next.js)
FACE_RECOGNITION_URL=http://127.0.0.1:8765

# Generate a separate random 32-byte key for encrypting biometric templates:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HR_FACE_ENCRYPTION_KEY=GENERATE_A_64_CHARACTER_HEX_KEY
